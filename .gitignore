# Logs
./logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
.coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Packaged VSCode extension bundles
*.vsix

# Built dictionary database (regenerated by `vp run build:data`, delivered via download)
/assets/jisho.db
/assets/jisho.db-wal
/assets/jisho.db-shm
/assets/jisho.db.version
# Built names database (regenerated by `vp run build:data:names`, delivered via download)
/assets/jisho-names.db
/assets/jisho-names.db-wal
/assets/jisho-names.db-shm
/assets/jisho-names.db.version
# Staging databases: a build writes `<db>.building` and renames it into place on success, so these
# exist only mid-build or after a failed one.
/assets/*.db.building
/assets/*.db.building-wal
/assets/*.db.building-shm
# Hand-kept local fixtures — e.g. a `common` build set aside while `assets/jisho.db` holds the full
# one. Regenerable (`vp run build:data`), personal to a checkout, never shipped.
/assets/*-backup.db
# Experimental Lindera FTS5 tokenizer extension (`vp run build:fts-extension`, Windows-only for
# now). A provisioned ~18MB build artifact, not source — see scripts/build-fts-extension.ts.
/assets/lindera-fts5/

# Typescript
*.tsbuildinfo

# Jest
/coverage
packages/**/coverage

# Yarn
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Storybook
storybook-static/

# dotenv environment variables file
.env
.env.*

.turbo
.next/
.cache/
**/dist/
coverage/
**/public/workbox-*.js*
**/public/sw.js*
**/public/worker-*.js*
results
yarn-error.log
.idea
schema.json

# Ignore user-specific VSCode state, but keep shared extension-dev config (F5 launch + build tasks)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

cypress/e2e/build

.DS_Store
.vercel/*
!.vercel/package.json

# Claude Code local agent state — but NOT the skills, which are project
# documentation: they carry this repo's conventions for anyone (or any agent)
# working on it, so they are versioned with the code they describe.
#
# The contents are excluded rather than the directory itself: git cannot
# re-include a path inside an excluded DIRECTORY, so `.claude/` followed by
# `!.claude/skills/` does not work.
.claude/*
!.claude/skills/

# CPU profiles emitted by scripts/profile.mjs
profiles/
*.cpuprofile

# E2E: the VS Code build @vscode/test-electron downloads (~224MB) and Playwright's run artifacts
.vscode-test/
test-results/
playwright-report/

# Temp vsix extraction for packaging verification
.vsix-verify.tmp/
/assets/jisho-full.db.zst
/assets/jisho-full.db.zst.sha256
/assets/jisho-full.db.zst.version
/assets/jisho-names.db.zst

# Compiled IPADIC tokenizer dictionary — provisioned by `vp run build:tokenizer-dict`
# (downloads the pinned lindera release), bundled into the .vsix, not committed. See docs/specs/14.
/assets/lindera-ipadic/
/assets/jisho-names.db.zst.sha256
/assets/jisho-names.db.zst.version

# Per-platform packages built by scripts/package-platforms.ts
dist-vsix/
.platform-pkgs.tmp/

# Vitest browser mode: failure screenshots + attachments, regenerated per run.
# (Committed visual-regression baselines, when we add them, will live elsewhere and be tracked.)
.vitest-attachments/
**/__screenshots__/
# Output of the *.preview.browser.spec.tsx visual benches — regenerated on every run.
**/*-preview.png

# Benchmark baselines are machine-specific: comparing your numbers to a teammate's (or CI's)
# hardware measures the hardware, not the change. Generate locally with `vp run bench:save`.
bench/baseline.json
# deoptkit's LSP feed is a transient artifact of the last run; .deopt/baselines/ IS committed, since
# structural findings are properties of the code rather than of the machine (see bench/README.md).
.deopt/findings.json
