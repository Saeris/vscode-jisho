.vscode/**
.claude/**
.github/**
.bumpy/**
.yarn/**
.yarnrc.yml
# Per-platform packaging scratch + output — the platform-binary backup dir and the .vsix output
# dir must never be packaged INTO a .vsix (they'd embed the host's binaries as dead weight).
.platform-pkgs.tmp/**
dist-vsix/**
.vsix-verify.tmp/**
.gitattributes
.gitignore
scripts/**
src/**
bench/**
media/**
!media/jisho.svg
# The Marketplace icon. `icon` in package.json points at this, so excluding it would ship a manifest
# referencing a file that is not in the package.
!media/icon.png
**/__tests__/**
**/*.spec.*
**/*.test.*
**/*.map
**/*.ts
!dist/**/*.d.ts
vite.config.*
tsconfig.json
yarn.lock
# Contributor-facing docs. vsce excludes CONTRIBUTING.md by default, but the intent is stated here
# so it does not depend on that. THIRD_PARTY_NOTICES.md deliberately DOES ship — several of the
# bundled datasets require their attribution to travel with the distribution.
CLAUDE.md
CONTRIBUTING.md
.claude/**
# Specs, plans, and the README's screenshots. The Marketplace rewrites the README's relative image
# paths to the GitHub repo and fetches them from there, so shipping the PNGs inside the .vsix would
# add weight that nothing ever reads.
docs/**

# The dictionary DB is delivered by download on first activation, not bundled.
assets/**
# …but the stroke-order SVGs ship in the package (with their APL licence files): they're read by
# the host per request, and keeping them out of the DB decouples stroke fixes from dictionary
# releases. See docs/STROKE-ORDER.md.
!assets/kanji-svgs/**
# …as do the kana drawings, kept in their own directory because they are LGPL rather than APL and
# ship the LGPL text that governs them.
!assets/kana-svgs/**
# …and the compiled IPADIC tokenizer dictionary IS bundled (loaded by path at runtime; ~55 MB,
# compresses small in the .vsix zip). See docs/specs/14.
!assets/lindera-ipadic/**
# …and the oniguruma WASM, which is the regex engine behind comment highlighting (spec 18).
# `vscode-oniguruma` ships it but does not embed it, so bundling the JS does not bring it along:
# it is read at runtime through `workspace.fs`, the same delivery path as the SVGs above, which is
# also what makes it work in the web extension host. ~460 KB.
!assets/onig.wasm

# Exclude node_modules by default, but the neverBundle'd runtime packages must ship in the
# .vsix — they are loaded from node_modules at runtime (Turso's native addon, Lindera's .node).
node_modules/**
# `lindera-nodejs` resolves a per-platform `.node` at runtime, so both it and the platform package
# must ship (only the current platform's is present after per-target packaging). The database needs
# no entry: it is Node's built-in `node:sqlite`.
!node_modules/lindera-nodejs/**
!node_modules/lindera-nodejs-*/**

# Tooling config and test residue. Each of these was found IN a built .vsix rather than reasoned
# about: `vsce ls` after a package run is the only way to know what actually ships, because a
# pattern that looks exhaustive above still misses whatever a tool wrote since.
.mcp.json
knip.json
e2e/**
test-results/**
.vitest-attachments/**
.deopt/**
# Compiled benchmarks. `bench/**` above keeps the sources out; this keeps their build output out
# too, which is 1.76 MB of code nothing in the extension loads.
dist/bench/**
